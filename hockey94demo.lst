seg050:40EB                                         ; memory mode. Data bits:
seg050:40EB                                         ; 0: 1=text char generator; 0=graphics
seg050:40EB                                         ; 1: 1=EGA ram > 64K; 0=64K
seg050:40EB                                         ; 2: 1=sequential; 0=odd/even
seg050:40EC                 inc     dx
seg050:40ED                 in      al, dx          ; EGA port: sequencer data register
seg050:40EE                 and     al, 0F7h
seg050:40F0                 or      al, 4
