seg050:40FF                 mov     al, 6
seg050:4101                 out     dx, al          ; EGA: graph 1 and 2 addr reg:
seg050:4101                                         ; miscellaneous graphics control.Data bits:
seg050:4101                                         ; 0: 1=graphics; 0=enable char gen (text)
seg050:4101                                         ; 1: 1=chain odd maps after even maps
seg050:4101                                         ; 2: memory mapping for CPU
seg050:4101                                         ;    00=a000H (128K);   01=a000H (64K)
seg050:4101                                         ;    10=b000H (32K MDA);11=b800H (32K CGA)
seg050:4102                 inc     dx
seg050:4103                 in      al, dx          ; EGA port: graphics controller data register
seg050:4104                 and     al, 0FDh
