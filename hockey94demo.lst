seg050:4125                 and     al, 0BFh
seg050:4127                 out     dx, al          ; Video: CRT controller internal registers
seg050:4128                 dec     dx
seg050:4129                 mov     al, 17h
seg050:412B                 out     dx, al          ; Video: CRT cntrlr addr
