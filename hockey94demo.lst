seg050:40F8                 out     dx, al          ; EGA: graph 1 and 2 addr reg:
seg050:40F8                                         ; mode register.Data bits:
seg050:40F8                                         ; 0-1: Write mode 0-2
seg050:40F8                                         ; 2: test condition
seg050:40F8                                         ; 3: read mode: 1=color compare, 0=direct
seg050:40F8                                         ; 4: 1=use odd/even RAM addressing
seg050:40F8                                         ; 5: 1=use CGA mid-res map (2-bits/pixel)
seg050:40F9                 inc     dx
